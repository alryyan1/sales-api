# Copy this file to .env and adjust as needed.

# Port this relay server listens on. Must match REALTIME_SERVER_URL's port in sales-api/.env
# and VITE_REALTIME_PORT in sales-ui/.env.
PORT=3001

# Must match REALTIME_SERVER_SECRET in sales-api/.env — requests without a matching
# X-Internal-Secret header are rejected. Leave both empty to disable the check.
REALTIME_SERVER_SECRET=change-me-please
